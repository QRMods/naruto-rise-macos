+    setenv("MVK_CONFIG_SHOULD_MAXIMIZE_CONCURRENT_COMPILATION", "1", 0);
+    // volk opens the loader by its name (libvulkan.1.dylib), which dyld finds in
+    // the system's folders or as an image already loaded under that name (an
+    // install name of @rpath/libvulkan.1.dylib): the app's loader is loaded
+    // first, and stays loaded.
+    for (const auto& candidate : paths.loader_candidates)
+      if (dlopen(candidate.c_str(), RTLD_NOW | RTLD_LOCAL)) break;
+  });
