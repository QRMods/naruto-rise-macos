 void SetThreadPriority(ThreadPriority priority) {
+#if defined(__APPLE__)
+  // macOS schedules by quality of service: utility work runs on the efficiency
+  // cores first, the default class beside the threads that publish the frames.
+  pthread_set_qos_class_self_np(priority == ThreadPriority::kLowest ? QOS_CLASS_UTILITY : QOS_CLASS_DEFAULT, 0);
+#else
   // Switching between these two needs no privilege; nice values stay as they are.
   const sched_param param{};
   pthread_setschedparam(pthread_self(), priority == ThreadPriority::kLowest ? SCHED_BATCH : SCHED_OTHER, &param);
