+#if defined(__cpp_lib_atomic_shared_ptr)
 std::atomic<std::shared_ptr<const Config>> current{std::make_shared<Config>()};
+#else
+// libc++ (macOS) has no std::atomic<std::shared_ptr>: a mutex guards the exchange.
+std::mutex current_mutex;
+std::shared_ptr<const Config> current_config = std::make_shared<Config>();
+struct {
+  std::shared_ptr<const Config> load() const {
+    std::lock_guard lock(current_mutex);
+    return current_config;
+  }
+  void store(std::shared_ptr<const Config> config) {
+    std::lock_guard lock(current_mutex);
+    current_config = std::move(config);
+  }
+} current;
+#endif
