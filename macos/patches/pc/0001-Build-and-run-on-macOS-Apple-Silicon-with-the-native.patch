+#if defined(__APPLE__)
+  // The Mach thread of the pthread gives its user and system times apart.
+  thread_basic_info_data_t info{};
+  mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+  const mach_port_t thread = pthread_mach_thread_np(reinterpret_cast<pthread_t>(native_thread));
+  if (thread == MACH_PORT_NULL ||
+      thread_info(thread, THREAD_BASIC_INFO, reinterpret_cast<thread_info_t>(&info), &count) != KERN_SUCCESS)
+    return false;
+  auto to_100ns = [](const time_value_t& t) { return uint64_t(t.seconds) * 10000000 + uint64_t(t.microseconds) * 10; };
+  kernel_100ns = to_100ns(info.system_time);
+  user_100ns = to_100ns(info.user_time);
+  return true;
