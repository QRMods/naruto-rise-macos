@@ -0,0 +1,103 @@
+// The achievements in the RmlUi of the menus: the toast of an unlocked
+// achievement, after the Xbox 360 one (achievement_toast.rml), and the list of
+// all of them with progress, gamerscore, icons, descriptions and unlock dates
+// (achievements.rml), which the Guide button opens like the console's guide,
+// also while a toast shows. The data comes from the app (the SDK's
+// AchievementManager); this only presents it. UI thread.
+#pragma once
+
+#include "menu/achievement_sound.h"
+#include <RmlUi/Core/EventListener.h>
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace Rml {
+class Context;
+class Element;
+class ElementDocument;
+}  // namespace Rml
+
+namespace narutorise::menu {
+
+struct Achievement {
+  uint32_t id = 0, image_id = 0, gamerscore = 0;
+  std::string name, description, locked_description;
+  bool unlocked = false;
+  bool secret = false;        // Hidden until unlocked (no "show unachieved" flag in the title).
+  uint64_t unlock_time = 0;   // FILETIME (UTC, 100 ns since 1601); 0 when unknown.
+};
+
+class Achievements final : public Rml::EventListener {
+ public:
+  // The language of the words around the achievements (Localization::Language
+  // order). The app passes the game's, the language of the names themselves.
+  void SetLanguage(size_t language) { language_ = language; }
+  void SetSoundFile(std::filesystem::path path) { sound_.SetFile(std::move(path)); }
+  void SetGamepadHints(bool gamepad);
+
+  // Toasts show one after another, and wait while the list shows.
+  void Push(Achievement achievement);
+  bool ToastActive() const { return toast_on_ || !queue_.empty(); }
+  std::optional<uint32_t> ToastId() const;
+  void SkipToast();
+
+  // The list over everything else; focus: the id selected first (0: the first row).
+  bool ShowList(Rml::Context& context, std::string game, std::vector<Achievement> list, uint32_t focus,
+                std::function<void()> close);
+  void HideList();
+  bool ListShown() const { return list_ != nullptr; }
+
+  // A frame, before the context's Update: the toast's animation and the list's lights.
+  void Tick(Rml::Context& context);
+  // The close the list asked for (Esc, B, its close button), run outside the event.
+  std::function<void()> TakePending();
+  void Shutdown();
+  void ProcessEvent(Rml::Event& event) override;
+
+ private:
+  using Clock = std::chrono::steady_clock;
+  int Px(float dp) const;
+  void StartToast(Rml::Context& context);
+  void ToastFrame(float t);
+  void EndToast(Clock::time_point now);
+  void FillHeader();
+  void Rebuild();
+  void Select(size_t row, bool scroll);
+  void Describe(const Achievement& achievement);
+  void SetHints();
+
+  size_t language_ = 0;
+  bool gamepad_ = false;
+  float ratio_ = 1;
+  AchievementSound sound_;
+
+  std::deque<Achievement> queue_;
+  std::optional<Achievement> current_;
+  bool toast_on_ = false;
+  float width_ = 320;
+  Clock::time_point toast_start_{}, next_toast_{};
+  Rml::ElementDocument* toast_ = nullptr;
+  struct {
+    Rml::Element *box, *pill, *shine, *words, *title, *name, *icon, *frame, *medal, *glow, *ring, *lights, *orb, *trophy;
+  } parts_{};
+
+  Rml::ElementDocument* list_ = nullptr;
+  std::vector<Achievement> items_;
+  std::vector<size_t> view_;  // The rows: indices of items_, filtered and sorted.
+  size_t selected_ = 0;
+  uint32_t selected_id_ = 0;
+  int filter_ = 0, sort_ = 0;
+  std::string game_;
+  std::function<void()> close_;
+  bool close_pending_ = false;
+  std::vector<std::function<void()>> deferred_;  // Rebuilds after the event that asked.
+  Clock::time_point list_start_{};
+};
+
+}  // namespace narutorise::menu
