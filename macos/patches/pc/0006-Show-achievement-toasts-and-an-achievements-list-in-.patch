+++ b/app/src/menu/achievements.cpp
@@ -0,0 +1,503 @@
+// The achievement toast and list (achievements.h).
+#include "menu/achievements.h"
+
+#include "menu/text.h"
+#include <algorithm>
+#include <cmath>
+#include <ctime>
+#include <RmlUi/Core.h>
+#include <fmt/format.h>
+#include <rex/logging.h>
+
+namespace narutorise::menu {
+namespace {
+
+constexpr float kPi = 3.14159265358979f;
+
+// The toast's timeline in seconds: the medal pops in (0-0.45), opens into the
+// pill (0.35-0.95), the words come in (0.8-1.2) and a light crosses it; the
+// ring blinks green, then holds (to 5.55), closes (5.85-6.35) and the medal
+// spins twice (6.2-6.92) and vanishes (6.72-7.02). While open, the orb and a
+// green trophy take turns in the ring about once a second, each change a
+// short blink.
+constexpr float kToastEnd = 7.1f;
+constexpr float kMedal = 64;          // dp: the medal and the height of the pill.
+constexpr float kWordsLeft = 78;      // dp
+constexpr auto kToastGap = std::chrono::milliseconds(350);
+// The changes between the orb and the trophy, about one a second: the trophy
+// shows after the odd ones, and the orb is back for the spin at the end.
+constexpr float kFaceChanges[] = {1.2f, 2.2f, 3.2f, 4.2f, 5.2f, 6.2f};
+constexpr float kBlink = 0.07f;  // Seconds each face takes to go out, and the next to come in.
+
+float Phase(float t, float start, float end) { return std::clamp((t - start) / (end - start), 0.0f, 1.0f); }
+float Lerp(float a, float b, float t) { return a + (b - a) * t; }
+float OutCubic(float x) { return 1 - std::pow(1 - x, 3.0f); }
+float InCubic(float x) { return x * x * x; }
+float InOutCubic(float x) { return x < 0.5f ? 4 * x * x * x : 1 - std::pow(-2 * x + 2, 3.0f) / 2; }
+float OutBack(float x) {
+  constexpr float c1 = 1.70158f, c3 = c1 + 1;
+  return 1 + c3 * std::pow(x - 1, 3.0f) + c1 * std::pow(x - 1, 2.0f);
+}
+float Seconds(std::chrono::steady_clock::duration d) { return std::chrono::duration<float>(d).count(); }
+
+std::string Escape(const std::string& text) { return Rml::StringUtilities::EncodeRml(text); }
+std::string Dp(float value) { return fmt::format("{:.3f}dp", value); }
+void Set(Rml::Element* element, const char* property, const std::string& value) { element->SetProperty(property, value); }
+void Set(Rml::Element* element, const char* property, float value) {
+  element->SetProperty(property, fmt::format("{:.4f}", std::clamp(value, 0.0f, 1.0f)));
+}
+
+std::string Fill(std::string_view pattern, std::string_view value) {
+  const size_t at = pattern.find("%s");
+  if (at == std::string_view::npos) return std::string(pattern);
+  return std::string(pattern.substr(0, at)).append(value).append(pattern.substr(at + 2));
+}
+
+// A local date and time in the customary order of the language.
+std::string FormatDate(uint64_t filetime, size_t language) {
+  constexpr uint64_t kUnixEpoch = 116444736000000000ull;  // 1970-01-01 in FILETIME.
+  if (filetime <= kUnixEpoch) return {};
+  const std::time_t seconds = std::time_t((filetime - kUnixEpoch) / 10000000ull);
+  std::tm local{};
+#ifdef _WIN32
+  if (localtime_s(&local, &seconds) != 0) return {};
+#else
+  if (!localtime_r(&seconds, &local)) return {};
+#endif
+  const char* format = language == 0 ? "%m/%d/%Y  %H:%M"
+                       : language == 3 || language == 6 ? "%d.%m.%Y  %H:%M"
+                                                       : "%d/%m/%Y  %H:%M";
+  char text[64];
+  return std::strftime(text, sizeof(text), format, &local) ? text : std::string{};
+}
+
+constexpr const char* kFilters[] = {"ach-filter-all", "ach-filter-unlocked", "ach-filter-locked"};
+constexpr const char* kSorts[] = {"ach-sort-recent", "ach-sort-game", "ach-sort-score", "ach-sort-name"};
+
+}  // namespace
+
+int Achievements::Px(float dp) const { return std::max(1, int(std::lround(dp * ratio_))); }
+
+void Achievements::SetGamepadHints(bool gamepad) {
+  gamepad_ = gamepad;
+  SetHints();
+}
+
+// The controls of the list as the controller's buttons (A green, B red, X
+// blue, the bumpers) or as keycaps, after the last input used.
+void Achievements::SetHints() {
+  if (!list_) return;
+  auto* hints = list_->GetElementById("hints");
+  if (!hints) return;
+  const auto hint = [this](const std::string& keys, const char* label) {
+    return fmt::format("<span class=\"hint\">{}{}</span>", keys, Escape(TextIn(label, language_)));
+  };
+  std::string rml;
+  if (gamepad_) {
+    rml = hint("<span class=\"cap dark\">↑↓</span>", "ach-hint-browse") +
+          hint("<span class=\"cap dark bumper\">LB</span><span class=\"cap dark bumper\">RB</span>", "ach-hint-filter") +
+          hint("<span class=\"btn x\">X</span>", "ach-hint-sort") + hint("<span class=\"btn b\">B</span>", "ach-hint-close");
+  } else {
+    rml = hint("<span class=\"cap\">↑</span><span class=\"cap\">↓</span>", "ach-hint-browse") +
+          hint("<span class=\"cap\">‹</span><span class=\"cap\">›</span>", "ach-hint-filter") +
+          hint("<span class=\"cap\">S</span>", "ach-hint-sort") + hint("<span class=\"cap\">Esc</span>", "ach-hint-close");
+  }
+  hints->SetInnerRML(rml);
+}
+
+// Cuts text that does not fit its element with an ellipsis, on whole UTF-8 characters.
+static void Ellipsize(Rml::Element* element, const std::string& text) {
+  const int room = int(element->GetClientWidth());
+  if (room <= 0 || Rml::ElementUtilities::GetStringWidth(element, text) <= room) return;
+  std::vector<size_t> ends;  // Where each character ends.
+  for (size_t i = 1; i <= text.size(); ++i)
+    if (i == text.size() || (uint8_t(text[i]) & 0xC0) != 0x80) ends.push_back(i);
+  size_t low = 0, high = ends.size();  // The longest prefix that fits with the ellipsis.
+  while (low < high) {
+    const size_t mid = (low + high + 1) / 2;
+    std::string candidate = text.substr(0, ends[mid - 1]);
+    while (!candidate.empty() && candidate.back() == ' ') candidate.pop_back();
+    if (Rml::ElementUtilities::GetStringWidth(element, candidate + "…") <= room) low = mid;
+    else high = mid - 1;
+  }
+  std::string cut = low ? text.substr(0, ends[low - 1]) : std::string{};
+  while (!cut.empty() && cut.back() == ' ') cut.pop_back();
+  element->SetInnerRML(Escape(cut + "…"));
+}
+
+void Achievements::Push(Achievement achievement) { queue_.push_back(std::move(achievement)); }
+
+std::optional<uint32_t> Achievements::ToastId() const {
+  if (toast_on_ && current_) return current_->id;
+  return std::nullopt;
+}
+
+void Achievements::SkipToast() {
+  if (toast_on_) EndToast(Clock::now() - kToastGap);
+}
+
+void Achievements::StartToast(Rml::Context& context) {
+  if (!toast_) {
+    toast_ = context.LoadDocument("achievement_toast.rml");
+    const auto get = [this](const char* id) { return toast_ ? toast_->GetElementById(id) : nullptr; };
+    parts_ = {get("toast"), get("pill"), get("shine"), get("words"), get("toast-title"), get("toast-name"),
+              get("toast-icon"), get("icon-frame"), get("medal"), get("glow"), get("ring"), get("lights"), get("orb"),
+              get("trophy")};
+    const Rml::Element* all[] = {parts_.box, parts_.pill, parts_.shine, parts_.words, parts_.title,
+                                 parts_.name, parts_.icon, parts_.frame, parts_.medal, parts_.glow,
+                                 parts_.ring, parts_.lights, parts_.orb, parts_.trophy};
+    if (std::find(std::begin(all), std::end(all), nullptr) != std::end(all)) {
+      REXLOG_WARN("[narutorise] Achievements: the toast document did not load");
+      if (toast_) toast_->Close();
+      toast_ = nullptr;
+      queue_.clear();
+      return;
+    }
+  }
+  current_ = std::move(queue_.front());
+  queue_.pop_front();
+  // Every image at the pixel size it shows at.
+  parts_.orb->SetAttribute("src", fmt::format("achievement/orb/{}", Px(45.333f)));
+  parts_.trophy->SetAttribute("src", fmt::format("achievement/trophy/{}", Px(45.333f)));
+  parts_.lights->SetAttribute("src", fmt::format("achievement/lights/{}", Px(kMedal)));
+  parts_.glow->SetAttribute("src", fmt::format("achievement/glow/{}", Px(150)));
+  parts_.shine->SetAttribute("src", fmt::format("achievement/shine/{}x{}", Px(96), Px(58.667f)));
+  parts_.icon->SetAttribute("src", fmt::format("achievement/icon/{}/{}", current_->image_id, Px(44)));
+  const std::string title = TextIn("ach-toast", language_);
+  const std::string name = fmt::format("{} G  –  {}", current_->gamerscore, current_->name);
+  parts_.title->SetInnerRML(Escape(title));
+  parts_.name->SetInnerRML(fmt::format("<span class=\"g\">{} G</span>  –  {}", current_->gamerscore,
+                                       Escape(current_->name)));
+  toast_->Show(Rml::ModalFlag::None, Rml::FocusFlag::None);
+  toast_->PullToFront();
+  toast_->UpdateDocument();  // The fonts of the words, to measure them.
+  const float words = float(std::max(Rml::ElementUtilities::GetStringWidth(parts_.title, title),
+                                     Rml::ElementUtilities::GetStringWidth(parts_.name, name))) / ratio_;
+  // The medal, the words, the icon at the right end with its margins.
+  width_ = std::clamp(kWordsLeft + words + 20 + 47 + 12, 300.0f, 860.0f);
+  toast_start_ = Clock::now();
+  toast_on_ = true;
+  ToastFrame(0);
+  sound_.Play();
+  REXLOG_INFO("[narutorise] Achievement toast: {} ({} G)", current_->name, current_->gamerscore);
+}
+
+void Achievements::ToastFrame(float t) {
+  // The medal: pops in with an overshoot, spins twice at the end and shrinks away.
+  const float vanish = Phase(t, 6.72f, 7.02f);
+  const float scale = Lerp(0.2f, 1, OutBack(Phase(t, 0, 0.45f))) * Lerp(1, 0.5f, InCubic(vanish));
+  const float spin = 720 * InOutCubic(Phase(t, 6.2f, 6.92f));
+  Set(parts_.medal, "transform", fmt::format("rotate({:.2f}deg) scale({:.4f})", spin, scale));
+  Set(parts_.medal, "opacity", Phase(t, 0, 0.16f) * (1 - vanish));
+  // A flash of light behind it as it pops, then a faint halo while open.
+  // The orb and the trophy take turns: both go dark for a moment at each change.
+  size_t changes = 0;
+  float nearest = 1e9f;
+  for (const float change : kFaceChanges) {
+    changes += t >= change;
+    nearest = std::min(nearest, std::fabs(t - change));
+  }
+  const bool trophy = changes % 2 == 1;
+  const float blink = std::clamp(nearest / kBlink, 0.0f, 1.0f);
+  Set(parts_.orb, "opacity", trophy ? 0.0f : blink);
+  Set(parts_.trophy, "opacity", trophy ? blink : 0.0f);
+  // A flash of light behind it as it pops and at each change, a faint halo while open.
+  const float flash = Phase(t, 0.08f, 0.3f) * (1 - Phase(t, 0.3f, 1.1f));
+  const float halo = 0.3f * Phase(t, 0.3f, 1.1f) * (1 - Phase(t, 5.9f, 6.4f));
+  const float pulse = 0.35f * (1 - std::clamp(nearest / 0.3f, 0.0f, 1.0f)) * (t < 6.4f ? 1.0f : 0.0f);
+  Set(parts_.glow, "opacity", flash + halo + pulse);
+  // The lights running around the orb inside its ring.
+  Set(parts_.lights, "transform", fmt::format("rotate({:.2f}deg)", t * 300));
+  Set(parts_.lights, "opacity", Phase(t, 0.25f, 0.65f) * (1 - Phase(t, 6.55f, 6.9f)));
+  // The top of the ring blinks green, then stays lit.
+  const bool lit = t >= 1.0f && (t >= 3.4f || int((t - 1.0f) / 0.24f) % 2 == 0);
+  Set(parts_.ring, "border-top-color", std::string(lit ? "#8dc63f" : "#605b57"));
+  // The pill opens from the medal, centered, and closes back into it.
+  const float open = OutCubic(Phase(t, 0.35f, 0.95f)) * (1 - InOutCubic(Phase(t, 5.85f, 6.35f)));
+  const float width = Lerp(kMedal, width_, open);
+  Set(parts_.box, "width", Dp(width));
+  Set(parts_.box, "margin-left", Dp(-width / 2));
+  Set(parts_.pill, "opacity", Phase(t, 0.3f, 0.4f) * (1 - Phase(t, 6.3f, 6.4f)));
+  // The words slide in; the icon pops at the right end.
+  const float out = Phase(t, 5.55f, 5.85f);
+  const float in = OutCubic(Phase(t, 0.8f, 1.2f));
+  Set(parts_.words, "opacity", in * (1 - out));
+  Set(parts_.words, "left", Dp(kWordsLeft + 14 * (1 - in)));
+  const float icon = Phase(t, 0.9f, 1.3f);
+  const std::string icon_scale = fmt::format("scale({:.4f})", Lerp(0.6f, 1, OutBack(icon)));
+  for (Rml::Element* element : {parts_.icon, parts_.frame}) {
+    Set(element, "opacity", icon * (1 - out));
+    Set(element, "transform", icon_scale);
+  }
+  // One sweep of light across the open pill.
+  const float sweep = Phase(t, 1.05f, 1.85f);
+  Set(parts_.shine, "left", Dp(Lerp(56, std::max(56.0f, width_ - 56 - 96), InOutCubic(sweep))));
+  Set(parts_.shine, "opacity", std::sin(kPi * sweep));
+}
+
+void Achievements::EndToast(Clock::time_point now) {
+  if (toast_) toast_->Hide();
+  toast_on_ = false;
+  current_.reset();
+  next_toast_ = now + kToastGap;
+}
+
+void Achievements::Tick(Rml::Context& context) {
+  ratio_ = context.GetDensityIndependentPixelRatio();
+  for (auto& rebuild : std::exchange(deferred_, {})) rebuild();
+  const auto now = Clock::now();
+  if (list_) {
+    const float t = Seconds(now - list_start_);
+    if (auto* lights = list_->GetElementById("head-lights"))
+      Set(lights, "transform", fmt::format("rotate({:.2f}deg)", std::fmod(t * 120, 360.0f)));
+    // It fades in and rises a little as it opens (no transform: the list scrolls with scissors).
+    const float open = OutCubic(Phase(t, 0, 0.22f));
+    if (auto* veil = list_->GetElementById("veil")) Set(veil, "opacity", open);
+    if (auto* sheet = list_->GetElementById("sheet")) {
+      Set(sheet, "opacity", open);
+      Set(sheet, "margin-top", Dp(-292 + 14 * (1 - open)));
+    }
+  }
+  if (!toast_on_ && !queue_.empty() && !list_ && now >= next_toast_) StartToast(context);
+  if (!toast_on_) return;
+  const float t = Seconds(now - toast_start_);
+  if (t >= kToastEnd) EndToast(now);
+  else ToastFrame(t);
+}
+
+bool Achievements::ShowList(Rml::Context& context, std::string game, std::vector<Achievement> list, uint32_t focus,
+                            std::function<void()> close) {
+  HideList();
+  ratio_ = context.GetDensityIndependentPixelRatio();
+  list_ = context.LoadDocument("achievements.rml");
+  if (!list_) {
+    REXLOG_WARN("[narutorise] Achievements: the list document did not load");
+    return false;
+  }
+  items_ = std::move(list);
+  game_ = std::move(game);
+  close_ = std::move(close);
+  close_pending_ = false;
+  filter_ = 0;
+  sort_ = 0;
+  selected_ = 0;
+  selected_id_ = focus;
+  list_start_ = Clock::now();
+  for (const char* event : {"keydown", "click", "mouseover"}) list_->AddEventListener(event, this);
+  FillHeader();
+  Rebuild();
+  list_->Show(Rml::ModalFlag::None, Rml::FocusFlag::Document);
+  list_->PullToFront();
+  // The list takes the place of the toast, as the console's guide did.
+  SkipToast();
+  return true;
+}
+
+void Achievements::HideList() {
+  if (!list_) return;
+  for (const char* event : {"keydown", "click", "mouseover"}) list_->RemoveEventListener(event, this);
+  list_->Close();
+  list_ = nullptr;
+  items_.clear();
+  view_.clear();
+  deferred_.clear();
+  close_ = {};
+  close_pending_ = false;
+}
+
+std::function<void()> Achievements::TakePending() {
+  if (!close_pending_) return {};
+  close_pending_ = false;
+  if (close_) return close_;
+  return [this] { HideList(); };
+}
+
+void Achievements::FillHeader() {
+  size_t unlocked = 0;
+  uint32_t score = 0, total = 0;
+  for (const Achievement& a : items_) {
+    total += a.gamerscore;
+    if (a.unlocked) ++unlocked, score += a.gamerscore;
+  }
+  const auto set = [this](const char* id, const std::string& rml) {
+    if (auto* element = list_->GetElementById(id)) element->SetInnerRML(rml);
+  };
+  set("head-title", Escape(TextIn("ach-title", language_)));
+  set("head-game", Escape(game_));
+  set("count-value", fmt::format("{}<span class=\"of\"> / {}</span>", unlocked, items_.size()));
+  set("count-label", Escape(TextIn("ach-count-label", language_)));
+  set("score-value", fmt::format("{}<span class=\"of\"> / {} G</span>", score, total));
+  set("score-label", Escape(TextIn("ach-score-label", language_)));
+  if (auto* fill = list_->GetElementById("progress-fill"))
+    Set(fill, "width", fmt::format("{:.2f}%", total ? 100.0 * score / total : 0.0));
+  const auto image = [this](const char* id, const std::string& source) {
+    if (auto* element = list_->GetElementById(id)) element->SetAttribute("src", source);
+  };
+  image("head-orb", fmt::format("achievement/orb/{}", Px(56)));
+  image("head-lights", fmt::format("achievement/lights/{}", Px(76)));
+  image("detail-glow", fmt::format("achievement/glow/{}", Px(280)));
+  image("detail-lock", fmt::format("achievement/lock/{}", Px(54.667f)));
+  SetHints();
+}
+
+void Achievements::Rebuild() {
+  if (!list_) return;
+  size_t counts[3] = {items_.size(), 0, 0};
+  for (const Achievement& a : items_) ++counts[a.unlocked ? 1 : 2];
+  std::string filters;
+  for (int i = 0; i < 3; ++i)
+    filters += fmt::format("<span class=\"filter{}\" id=\"filter-{}\">{}  <span class=\"n\">{}</span></span>",
+                           i == filter_ ? " selected" : "", i, Escape(TextIn(kFilters[i], language_)), counts[i]);
+  if (auto* element = list_->GetElementById("filters")) element->SetInnerRML(filters);
+  if (auto* element = list_->GetElementById("sort"))
+    element->SetInnerRML(Escape(Fill(TextIn("ach-sort-format", language_), TextIn(kSorts[sort_], language_))));
+
+  const auto hidden = [](const Achievement& a) { return a.secret && !a.unlocked; };
+  const auto shown_name = [&](const Achievement& a) {
+    return Rml::StringUtilities::ToLower(hidden(a) ? std::string(TextIn("ach-secret", language_)) : a.name);
+  };
+  view_.clear();
+  for (size_t i = 0; i < items_.size(); ++i)
+    if (filter_ == 0 || (filter_ == 1) == items_[i].unlocked) view_.push_back(i);
+  std::stable_sort(view_.begin(), view_.end(), [&](size_t l, size_t r) {
+    const Achievement &a = items_[l], &b = items_[r];
+    switch (sort_) {
+      case 0:  // Recent: the latest unlocks first, then the rest in the game's order.
+        if (a.unlocked != b.unlocked) return a.unlocked;
+        if (a.unlocked && a.unlock_time != b.unlock_time) return a.unlock_time > b.unlock_time;
+        return a.id < b.id;
+      case 2:
+        if (a.gamerscore != b.gamerscore) return a.gamerscore > b.gamerscore;
+        if (a.unlocked != b.unlocked) return a.unlocked;
+        return a.id < b.id;
+      case 3: return shown_name(a) < shown_name(b);
+      default: return a.id < b.id;
+    }
+  });
+
+  std::string rows;
+  std::vector<std::pair<std::string, std::string>> texts;
+  for (size_t k = 0; k < view_.size(); ++k) {
+    const Achievement& a = items_[view_[k]];
+    const std::string icon = hidden(a) ? fmt::format("achievement/lock/{}", Px(48))
+                                       : fmt::format("achievement/{}/{}/{}", a.unlocked ? "icon" : "locked",
+                                                     a.image_id, Px(48));
+    const std::string name = hidden(a) ? std::string(TextIn("ach-secret", language_)) : a.name;
+    const std::string sub = a.unlocked ? a.description
+                            : hidden(a) ? std::string(TextIn("ach-secret-text", language_))
+                                        : (a.locked_description.empty() ? a.description : a.locked_description);
+    rows += fmt::format(
+        "<div class=\"row{}\" id=\"row-{}\"><div class=\"mark\"/><img class=\"row-icon\" src=\"{}\"/>"
+        "<span class=\"row-name\" id=\"name-{}\">{}</span><span class=\"row-sub\" id=\"sub-{}\">{}</span>"
+        "<span class=\"row-score\">{} G</span></div>",
+        a.unlocked ? "" : " locked", k, icon, k, Escape(name), k, Escape(sub), a.gamerscore);
+    texts.emplace_back(name, sub);
+  }
+  if (rows.empty()) rows = fmt::format("<span class=\"empty\">{}</span>", Escape(TextIn("ach-empty", language_)));
+  if (auto* element = list_->GetElementById("list")) element->SetInnerRML(rows);
+  list_->UpdateDocument();  // The rows' widths and fonts, for the ellipses.
+  for (size_t k = 0; k < texts.size(); ++k) {
+    if (auto* name = list_->GetElementById(fmt::format("name-{}", k))) Ellipsize(name, texts[k].first);
+    if (auto* sub = list_->GetElementById(fmt::format("sub-{}", k))) Ellipsize(sub, texts[k].second);
+  }
+
+  size_t row = 0;
+  for (size_t k = 0; k < view_.size(); ++k)
+    if (items_[view_[k]].id == selected_id_) row = k;
+  selected_ = row;
+  if (auto* detail = list_->GetElementById("detail")) detail->SetProperty("visibility", view_.empty() ? "hidden" : "visible");
+  Select(row, true);
+}
+
+void Achievements::Select(size_t row, bool scroll) {
+  if (!list_ || view_.empty()) return;
+  row = std::min(row, view_.size() - 1);
+  if (auto* previous = list_->GetElementById(fmt::format("row-{}", selected_))) previous->SetClass("selected", false);
+  selected_ = row;
+  selected_id_ = items_[view_[row]].id;
+  if (auto* element = list_->GetElementById(fmt::format("row-{}", row))) {
+    element->SetClass("selected", true);
+    if (scroll) element->ScrollIntoView(Rml::ScrollIntoViewOptions(Rml::ScrollAlignment::Nearest));
+  }
+  Describe(items_[view_[row]]);
+}
+
+void Achievements::Describe(const Achievement& a) {
+  const bool hidden = a.secret && !a.unlocked;
+  auto* detail = list_->GetElementById("detail");
+  if (!detail) return;
+  detail->SetClass("locked", !a.unlocked);
+  detail->SetClass("secret", hidden);
+  const auto set = [this](const char* id, const std::string& text) {
+    if (auto* element = list_->GetElementById(id)) element->SetInnerRML(Escape(text));
+  };
+  if (auto* icon = list_->GetElementById("detail-icon"))
+    icon->SetAttribute("src", hidden ? fmt::format("achievement/lock/{}", Px(156))
+                                     : fmt::format("achievement/{}/{}/{}", a.unlocked ? "icon" : "locked", a.image_id,
+                                                   Px(156)));
+  set("detail-name", hidden ? std::string(TextIn("ach-secret", language_)) : a.name);
+  set("detail-score", fmt::format("{} G", a.gamerscore));
+  set("detail-state", TextIn(a.unlocked ? "ach-state-unlocked" : "ach-state-locked", language_));
+  set("detail-text", a.unlocked ? a.description
+                     : hidden   ? std::string(TextIn("ach-secret-text", language_))
+                                : (a.locked_description.empty() ? a.description : a.locked_description));
+  const std::string date = a.unlocked ? FormatDate(a.unlock_time, language_) : std::string{};
+  set("detail-date", date.empty() ? std::string{} : Fill(TextIn("ach-unlocked-on", language_), date));
+}
+
+void Achievements::ProcessEvent(Rml::Event& event) {
+  if (!list_) return;
+  const Rml::String& type = event.GetType();
+  if (type == "keydown") {
+    using namespace Rml::Input;
+    const auto filter = [this](int step) {
+      deferred_.push_back([this, step] { filter_ = (filter_ + 3 + step) % 3; Rebuild(); });
+    };
+    switch (event.GetParameter<int>("key_identifier", 0)) {
+      case KI_UP: if (selected_ > 0) Select(selected_ - 1, true); break;
+      case KI_DOWN: Select(selected_ + 1, true); break;
+      case KI_HOME: Select(0, true); break;
+      case KI_END: if (!view_.empty()) Select(view_.size() - 1, true); break;
+      case KI_LEFT: case KI_PRIOR: filter(-1); break;
+      case KI_RIGHT: case KI_NEXT: filter(1); break;
+      case KI_DELETE: case KI_S:
+        deferred_.push_back([this] { sort_ = (sort_ + 1) % 4; Rebuild(); });
+        break;
+      case KI_ESCAPE: case KI_BACK: close_pending_ = true; break;
+      default: return;
+    }
+    event.StopPropagation();
+    return;
+  }
+  for (Rml::Element* target = event.GetTargetElement(); target && target != list_; target = target->GetParentNode()) {
+    const Rml::String& id = target->GetId();
+    if (id.rfind("row-", 0) == 0) {
+      Select(size_t(std::strtoul(id.c_str() + 4, nullptr, 10)), false);
+      return;
+    }
+    if (id.rfind("filter-", 0) == 0) {
+      if (type == "click") {
+        const int filter = id[7] - '0';
+        deferred_.push_back([this, filter] { filter_ = std::clamp(filter, 0, 2); Rebuild(); });
+      }
+      return;
+    }
+    if (id == "sheet-close") {
+      if (type == "click") close_pending_ = true;
+      return;
+    }
+  }
+}
+
+void Achievements::Shutdown() {
+  HideList();
+  if (toast_) toast_->Close();
+  toast_ = nullptr;
+  parts_ = {};
+  toast_on_ = false;
+  current_.reset();
+  queue_.clear();
+  sound_.Shutdown();
+}
+
+}  // namespace narutorise::menu
diff --git a/app/src/menu/achievements.h b/app/src/menu/achievements.h
