@@ -0,0 +1,47 @@
+// The images of the achievement toast and list, made on the CPU at the exact
+// pixel size they show at, so they stay sharp at any window size: the game's
+// own achievement icons (PNG in the title's XDBF, 64x64) resampled with a
+// Catmull-Rom filter and rounded, their locked versions, the orb of the toast
+// (a local file, or a neutral procedural sphere without it), and the lights,
+// glow, shine and padlock, which are procedural. RmlUi asks for them by
+// source (RenderInterface::LoadTexture):
+//   achievement/icon/<image id>/<px>     the icon, rounded corners
+//   achievement/locked/<image id>/<px>   the icon dimmed and desaturated
+//   achievement/orb/<px>                 the orb of the toast and the list
+//   achievement/trophy/<px>              a green trophy on a black disc, the
+//                                        orb's other face in the toast
+//   achievement/lights/<px>              two comets running around a ring
+//   achievement/glow/<px>                a soft round glow
+//   achievement/shine/<w>x<h>            a slanted band of light
+//   achievement/lock/<px>                a padlock badge
+// UI thread only, as RmlUi.
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <functional>
+#include <optional>
+#include <span>
+#include <string_view>
+#include <vector>
+
+namespace narutorise::menu::achievement_art {
+
+struct Image {
+  uint32_t width = 0, height = 0;
+  std::vector<uint8_t> rgba;  // Straight alpha, rows top to bottom.
+};
+
+// The PNG bytes of an achievement image by its XDBF image id; empty without one.
+void SetIconSource(std::function<std::vector<uint8_t>(uint32_t image_id)> source);
+// The orb's image file (any format stb decodes); a procedural sphere without it.
+void SetOrbFile(std::filesystem::path path);
+
+// The image of an achievement/... source, or nothing for another source.
+std::optional<Image> Load(std::string_view source);
+
+// Exposed for tests.
+Image Resample(const Image& source, uint32_t width, uint32_t height);
+Image Decode(std::span<const uint8_t> bytes);
+
+}  // namespace narutorise::menu::achievement_art
