+// The sound of an unlocked achievement (achievement_sound.h).
+#include "menu/achievement_sound.h"
+
+#include <SDL3/SDL.h>
+#include <rex/logging.h>
+
+namespace narutorise::menu {
+
+bool AchievementSound::Load() {
+  if (stream_) return true;
+  if (failed_ || path_.empty()) return false;
+  failed_ = true;  // Until it opens: a missing file or device is reported once.
+  std::error_code ec;
+  if (!std::filesystem::is_regular_file(path_, ec)) {
+    REXLOG_INFO("[narutorise] Achievements: no unlock sound at {}", path_.string());
+    return false;
+  }
+  if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+    REXLOG_WARN("[narutorise] Achievements: no audio for the unlock sound: {}", SDL_GetError());
+    return false;
+  }
+  audio_ = true;
+  SDL_AudioSpec spec{};
+  if (!SDL_LoadWAV(path_.string().c_str(), &spec, &samples_, &size_)) {
+    REXLOG_WARN("[narutorise] Achievements: the unlock sound {} did not load: {}", path_.string(), SDL_GetError());
+    return false;
+  }
+  stream_ = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+  if (!stream_) {
+    REXLOG_WARN("[narutorise] Achievements: no output for the unlock sound: {}", SDL_GetError());
+    return false;
+  }
+  // A little under full scale, so it sits with the game's mix instead of over it.
+  SDL_SetAudioStreamGain(stream_, 0.85f);
+  failed_ = false;
+  return true;
+}
+
+void AchievementSound::Play() {
+  if (!Load()) return;
+  SDL_ClearAudioStream(stream_);
+  SDL_PutAudioStreamData(stream_, samples_, int(size_));
+  SDL_FlushAudioStream(stream_);
+  SDL_ResumeAudioStreamDevice(stream_);
+}
+
+void AchievementSound::Shutdown() {
+  if (stream_) SDL_DestroyAudioStream(stream_);
+  stream_ = nullptr;
+  if (samples_) SDL_free(samples_);
+  samples_ = nullptr;
+  size_ = 0;
+  if (audio_) SDL_QuitSubSystem(SDL_INIT_AUDIO);
+  audio_ = false;
+}
+
+}  // namespace narutorise::menu
