+/* The achievement toast, after the Xbox 360 one: a medal pops in at the
+   bottom center, opens into a pill with the name and the gamerscore, closes
+   and spins away. Achievements::Toast drives every moving property per frame;
+   the images are made at their pixel size (achievement_art.h). */
+body { position: absolute; width: 100%; height: 100%; pointer-events: none; z-index: 90; }
+#lane { position: absolute; left: 0; right: 0; bottom: 58.667dp; height: 64dp; }
+#toast { position: absolute; left: 50%; top: 0; width: 64dp; height: 64dp; margin-left: -32dp; }
+#pill { position: absolute; left: 0; top: 0; width: 100%; height: 64dp; box-sizing: border-box; border: 2.667dp #4c4846; border-radius: 32dp; decorator: vertical-gradient(#3e3a38f5 #1a1817f5); }
+#gloss { position: absolute; left: 30dp; right: 30dp; top: 2.667dp; height: 21.333dp; border-radius: 10.667dp; background-color: #ffffff0e; }
+#shine { position: absolute; left: 64dp; top: 0; width: 96dp; height: 58.667dp; opacity: 0; }
+#words { position: absolute; left: 78dp; top: 11.333dp; white-space: nowrap; opacity: 0; }
+#toast-title { display: block; font-family: "Roboto Condensed"; font-size: 15.333dp; color: #d4d4d4; font-effect: shadow(0dp 1.333dp #000000c0); }
+#toast-name { display: block; margin-top: 0.667dp; font-family: "Roboto Condensed"; font-size: 19.333dp; font-weight: bold; color: #ffffff; font-effect: shadow(0dp 1.333dp #000000d0); }
+#toast-name span { display: inline; }
+.g { color: #a8da5c; }
+#toast-icon { position: absolute; right: 11.333dp; top: 10dp; width: 44dp; height: 44dp; opacity: 0; }
+#icon-frame { position: absolute; right: 10dp; top: 8.667dp; width: 46.667dp; height: 46.667dp; box-sizing: border-box; border: 1.333dp #ffffff2e; border-radius: 7.333dp; opacity: 0; }
+#medal { position: absolute; left: 0; top: 0; width: 64dp; height: 64dp; opacity: 0; }
+#glow { position: absolute; left: -43dp; top: -43dp; width: 150dp; height: 150dp; opacity: 0; }
+#ring { position: absolute; left: 0; top: 0; width: 64dp; height: 64dp; box-sizing: border-box; border: 2.667dp #605b57; border-radius: 32dp; background-color: #0b0b0bf2; }
+#lights { position: absolute; left: 0; top: 0; width: 64dp; height: 64dp; opacity: 0; }
+#orb, #trophy { position: absolute; left: 9.333dp; top: 9.333dp; width: 45.333dp; height: 45.333dp; }
+#trophy { opacity: 0; }
