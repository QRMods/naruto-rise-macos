+// The sound of an unlocked achievement: a WAV file played through SDL's
+// default output, opened on the first unlock and kept for the next ones.
+// Without the file the toast is silent. UI thread.
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+
+struct SDL_AudioStream;
+
+namespace narutorise::menu {
+
+class AchievementSound {
+ public:
+  ~AchievementSound() { Shutdown(); }
+  void SetFile(std::filesystem::path path) { Shutdown(); path_ = std::move(path); failed_ = false; }
+  void Play();
+  void Shutdown();
+
+ private:
+  bool Load();
+  std::filesystem::path path_;
+  bool failed_ = false, audio_ = false;
+  uint8_t* samples_ = nullptr;
+  uint32_t size_ = 0;
+  SDL_AudioStream* stream_ = nullptr;
+};
+
+}  // namespace narutorise::menu
diff --git a/app/src/menu/achievements.cpp b/app/src/menu/achievements.cpp
