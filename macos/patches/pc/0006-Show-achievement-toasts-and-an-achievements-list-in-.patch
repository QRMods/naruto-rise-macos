diff --git a/app/src/menu/home_button.h b/app/src/menu/home_button.h
new file mode 100644
index 0000000..bbef402
--- /dev/null
+++ b/app/src/menu/home_button.h
@@ -0,0 +1,27 @@
+// The controllers' Home (Guide, PS) button on macOS. GameController hands a
+// press to the app in front only while the app claims the button; SDL claims
+// it when it opens a controller and gives it back when it closes one, which
+// the game's input services do now and then. While the game runs,
+// ClaimHomeButton claims it again on every controller, so a press always
+// reaches the game (the achievements). macOS 26 acts on the press as well and
+// no app can stop it: about half a second later, when the button is released,
+// it shows its Game Overlay over a game it lists for it, or opens its Games
+// app. So after a press the game took (NoteHomePress), the overlay is hidden
+// again (closed if it stays in front) and the Games app closed (hidden when it
+// was open already), and the game stays in front. The closed overlay is also
+// what hands the button to the system: RestoreSystemOverlay starts it again
+// when another app comes to the front or the game closes. Elsewhere they do
+// nothing. UI (main) thread.
+#pragma once
+
+namespace narutorise::menu {
+#ifdef __APPLE__
+void ClaimHomeButton();
+void NoteHomePress();
+void RestoreSystemOverlay();
+#else
+inline void ClaimHomeButton() {}
+inline void NoteHomePress() {}
+inline void RestoreSystemOverlay() {}
+#endif
+}  // namespace narutorise::menu
diff --git a/app/src/menu/home_button_mac.mm b/app/src/menu/home_button_mac.mm
new file mode 100644
index 0000000..8dc9227
--- /dev/null
+++ b/app/src/menu/home_button_mac.mm
@@ -0,0 +1,182 @@
+// The controllers' Home button on macOS (home_button.h).
+#include "menu/home_button.h"
+
+#import <AppKit/AppKit.h>
+#import <Foundation/Foundation.h>
+#import <GameController/GameController.h>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <chrono>
+#include <string>
+#include <rex/logging.h>
+
+extern char** environ;
+
+namespace narutorise::menu {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+int claims_logged = 0;
+// The last press of the Home button the game took, while its window had the focus,
+// on the steady clock and as an NSDate reference time (no object to retain).
+Clock::time_point home_pressed{};
+NSTimeInterval home_pressed_at = 0;
+// The system acts when the button is released, about half a second after the
+// game sees it pressed; a long press acts later still.
+constexpr auto kSystemDelay = std::chrono::seconds(3);
+NSString* const kGamesApp = @"com.apple.games";
+NSString* const kGameOverlay = @"com.apple.GameOverlayUI";
+// The game closed the Game Overlay, which is also what hands the Home button to
+// the system: until it runs again, the button does nothing outside the game.
+bool overlay_closed = false;
+
+// Every button of the controller the system binds to a gesture, the Home
+// button first among them, is the game's while it is in front.
+void Claim(GCController* controller) API_AVAILABLE(macos(11.0)) {
+  if (!controller) return;
+  NSDictionary<NSString*, GCControllerButtonInput*>* buttons = controller.physicalInputProfile.buttons;
+  for (NSString* name in buttons) {
+    GCControllerButtonInput* button = buttons[name];
+    const bool home = [name isEqualToString:GCInputButtonHome];
+    if (!home && !button.boundToSystemGesture) continue;
+    if (button.preferredSystemGestureState == GCSystemGestureStateDisabled) continue;
+    button.preferredSystemGestureState = GCSystemGestureStateDisabled;
+    // Each time SDL gave it back; a few lines are enough to see it happen.
+    if (claims_logged < 8) {
+      ++claims_logged;
+      const char* product = controller.productCategory.UTF8String;
+      REXLOG_INFO("[narutorise] Controller button '{}' of {} claimed from the system (bound to a system gesture: {})",
+                  name.UTF8String, product ? product : "a controller", button.boundToSystemGesture ? "yes" : "no");
+    }
+  }
+}
+
+bool PressedRecently() { return home_pressed != Clock::time_point{} && Clock::now() - home_pressed < kSystemDelay; }
+
+// macOS 26 acts on the Home button whatever the game claims: for a game it
+// shows its Game Overlay over, the overlay comes up over the game and takes the
+// controller; for another it opens its Games app. Right after a press the game
+// took, either gives way and the game is in front again: the overlay is hidden
+// (closed if it stays in front), the Games app closed when the press opened it,
+// hidden when it was open already.
+void GiveWay(NSRunningApplication* app) {
+  if (!app || app.terminated || !PressedRecently()) return;
+  const bool overlay = [app.bundleIdentifier isEqualToString:kGameOverlay];
+  if (!overlay && ![app.bundleIdentifier isEqualToString:kGamesApp]) return;
+  const char* done;
+  if (overlay) {
+    [app hide];
+    done = "hid the Game Overlay";
+    // A system service: if hiding did not take it from the front, it closes.
+    // Then later presses reach only the game, and RestoreSystemOverlay starts
+    // it again when the game is left.
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, int64_t(200 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{
+      if (app.terminated || (!app.active && app.hidden)) return;
+      [app forceTerminate];
+      overlay_closed = true;
+      REXLOG_INFO("[narutorise] Home button: closed the Game Overlay, which stayed in front");
+    });
+  } else {
+    NSDate* launched = app.launchDate;
+    const bool opened_by_press = launched && launched.timeIntervalSinceReferenceDate > home_pressed_at - 0.5;
+    if (opened_by_press) [app forceTerminate];
+    else [app hide];
+    done = opened_by_press ? "closed the Games app" : "hid the Games app";
+  }
+  if (@available(macOS 14.0, *)) [NSApp activate];
+  else [NSApp activateIgnoringOtherApps:YES];
+  REXLOG_INFO("[narutorise] Home button: {} the system opened ({:.0f} ms after the press)", done,
+              std::chrono::duration<double, std::milli>(Clock::now() - home_pressed).count());
+  home_pressed = {};  // Once per press.
+}
+
+}  // namespace
+
+void RestoreSystemOverlay() {
+  if (!overlay_closed) return;
+  overlay_closed = false;
+  if ([NSRunningApplication runningApplicationsWithBundleIdentifier:kGameOverlay].count) return;
+  // open -g starts it in the background and returns once it runs: done before
+  // the game's _Exit when the window closes.
+  const char* argv[] = {"/usr/bin/open", "-g", "-b", "com.apple.GameOverlayUI", nullptr};
+  pid_t pid = 0;
+  if (posix_spawn(&pid, argv[0], nullptr, nullptr, const_cast<char* const*>(argv), environ) != 0) return;
+  int status = 0;
+  waitpid(pid, &status, 0);
+  REXLOG_INFO("[narutorise] Home button: the Game Overlay runs again for the other apps");
+}
+
+void NoteHomePress() {
+  home_pressed = Clock::now();
+  home_pressed_at = [NSDate timeIntervalSinceReferenceDate];
+}
+
+void ClaimHomeButton() {
+  if (@available(macOS 11.0, *)) {
+    static bool observing = false;
+    if (!observing) {
+      observing = true;
+      // A controller that connects is claimed at once, before its first press.
+      [[NSNotificationCenter defaultCenter] addObserverForName:GCControllerDidConnectNotification
+                                                        object:nil
+                                                         queue:[NSOperationQueue mainQueue]
+                                                    usingBlock:^(NSNotification* note) {
+                                                      Claim(note.object);
+                                                    }];
+      // Another app in front: the Home button is the system's again there. Not
+      // while the overlay or the Games app takes the front right after a press.
+      [[NSNotificationCenter defaultCenter] addObserverForName:NSApplicationDidResignActiveNotification
+                                                        object:nil
+                                                         queue:[NSOperationQueue mainQueue]
+                                                    usingBlock:^(NSNotification*) {
+                                                      if (!PressedRecently()) RestoreSystemOverlay();
+                                                    }];
+      // The Games app or the Game Overlay as soon as the system starts or raises it.
+      NSNotificationCenter* workspace = [[NSWorkspace sharedWorkspace] notificationCenter];
+      for (NSNotificationName name in @[ NSWorkspaceDidLaunchApplicationNotification,
+                                         NSWorkspaceDidActivateApplicationNotification ]) {
+        [workspace addObserverForName:name
+                               object:nil
+                                queue:[NSOperationQueue mainQueue]
+                           usingBlock:^(NSNotification* note) {
+                             GiveWay(note.userInfo[NSWorkspaceApplicationKey]);
+                           }];
+      }
+    }
+    // Often enough that a controller SDL just closed and gave back is the
+    // game's again before a press: the check is a few property reads.
+    static auto last = Clock::time_point{};
+    const auto now = Clock::now();
+    if (now - last < std::chrono::milliseconds(100)) return;
+    last = now;
+    // In case a notification came before the press was noted.
+    if (PressedRecently()) {
+      for (NSRunningApplication* app in [NSRunningApplication runningApplicationsWithBundleIdentifier:kGamesApp])
+        if (app.active || (app.launchDate && app.launchDate.timeIntervalSinceReferenceDate > home_pressed_at - 0.5))
+          GiveWay(app);
+      for (NSRunningApplication* app in [NSRunningApplication runningApplicationsWithBundleIdentifier:kGameOverlay])
+        if (app.active) GiveWay(app);
+    }
+    NSArray<GCController*>* controllers = GCController.controllers;
+    // What the system shows the game, once per change of the controllers.
+    static NSUInteger described = NSUIntegerMax;
+    if (controllers.count != described) {
+      described = controllers.count;
+      REXLOG_INFO("[narutorise] Home button: {} controller(s) through GameController", controllers.count);
+      for (GCController* controller in controllers) {
+        GCControllerButtonInput* home = controller.physicalInputProfile.buttons[GCInputButtonHome];
+        const char* name = controller.vendorName.UTF8String;
+        REXLOG_INFO("[narutorise] Home button: {}: {}, bound to a system gesture: {}, state before the claim: {}",
+                    name ? name : "a controller", home ? "present" : "absent",
+                    home && home.boundToSystemGesture ? "yes" : "no",
+                    !home ? "-" : home.preferredSystemGestureState == GCSystemGestureStateDisabled ? "disabled"
+                          : home.preferredSystemGestureState == GCSystemGestureStateAlwaysReceive ? "always receive"
+                                                                                                  : "enabled");
+      }
+    }
+    for (GCController* controller in controllers) Claim(controller);
+  }
+}
+
+}  // namespace narutorise::menu
