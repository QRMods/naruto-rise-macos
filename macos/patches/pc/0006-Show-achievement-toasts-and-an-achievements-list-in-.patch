--- /dev/null
+++ b/app/src/menu/achievement_art.cpp
@@ -0,0 +1,406 @@
+// The images of the achievements (achievement_art.h).
+#include "menu/achievement_art.h"
+
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <fstream>
+#include <string>
+#include <rex/logging.h>
+#include <rex/ui/image_decode.h>
+
+namespace narutorise::menu::achievement_art {
+namespace {
+
+std::function<std::vector<uint8_t>(uint32_t)> icon_source;
+std::filesystem::path orb_file;
+
+constexpr float kPi = 3.14159265358979f;
+// The accents of the toast and the list: the green of the light, and the white of its core.
+constexpr float kGreen[3] = {141, 198, 63};
+constexpr float kCore[3] = {236, 255, 214};
+
+float Clamp01(float v) { return std::clamp(v, 0.0f, 1.0f); }
+float SmoothStep(float edge0, float edge1, float x) {
+  const float t = Clamp01((x - edge0) / (edge1 - edge0));
+  return t * t * (3 - 2 * t);
+}
+// Coverage of a pixel by a shape from its signed distance in pixels.
+float Coverage(float distance_px) { return Clamp01(0.5f - distance_px); }
+
+Image Blank(uint32_t width, uint32_t height) {
+  Image image;
+  image.width = width;
+  image.height = height;
+  image.rgba.assign(size_t(width) * height * 4, 0);
+  return image;
+}
+
+// Straight-alpha "over" of a color with coverage a onto one pixel.
+void Blend(uint8_t* p, const float rgb[3], float a) {
+  a = Clamp01(a);
+  if (a <= 0) return;
+  const float da = p[3] / 255.0f;
+  const float oa = a + da * (1 - a);
+  for (int c = 0; c < 3; ++c) {
+    const float value = (rgb[c] * a + p[c] * da * (1 - a)) / oa;
+    p[c] = uint8_t(std::clamp(value, 0.0f, 255.0f) + 0.5f);
+  }
+  p[3] = uint8_t(oa * 255 + 0.5f);
+}
+
+void Over(Image& destination, const Image& source, int left, int top) {
+  for (uint32_t y = 0; y < source.height; ++y) {
+    const int dy = top + int(y);
+    if (dy < 0 || dy >= int(destination.height)) continue;
+    for (uint32_t x = 0; x < source.width; ++x) {
+      const int dx = left + int(x);
+      if (dx < 0 || dx >= int(destination.width)) continue;
+      const uint8_t* s = &source.rgba[(size_t(y) * source.width + x) * 4];
+      const float rgb[3] = {float(s[0]), float(s[1]), float(s[2])};
+      Blend(&destination.rgba[(size_t(dy) * destination.width + dx) * 4], rgb, s[3] / 255.0f);
+    }
+  }
+}
+
+// Signed distance (in units of the shape) to a rounded rectangle centered at
+// (cx, cy) with half sizes (hx, hy) and corner radius r.
+float RoundedBox(float x, float y, float cx, float cy, float hx, float hy, float r) {
+  const float qx = std::fabs(x - cx) - (hx - r), qy = std::fabs(y - cy) - (hy - r);
+  return std::hypot(std::max(qx, 0.0f), std::max(qy, 0.0f)) + std::min(std::max(qx, qy), 0.0f) - r;
+}
+
+void MaskRounded(Image& image, float radius) {
+  const float w = float(image.width), h = float(image.height);
+  for (uint32_t y = 0; y < image.height; ++y)
+    for (uint32_t x = 0; x < image.width; ++x) {
+      uint8_t* p = &image.rgba[(size_t(y) * image.width + x) * 4];
+      const float cover = Coverage(RoundedBox(x + 0.5f, y + 0.5f, w / 2, h / 2, w / 2, h / 2, radius));
+      p[3] = uint8_t(p[3] * cover + 0.5f);
+    }
+}
+
+void MaskCircle(Image& image) { MaskRounded(image, image.width / 2.0f); }
+
+float CatmullRom(float x) {
+  x = std::fabs(x);
+  if (x < 1) return 1.5f * x * x * x - 2.5f * x * x + 1;
+  if (x < 2) return -0.5f * x * x * x + 2.5f * x * x - 4 * x + 2;
+  return 0;
+}
+
+struct Tap {
+  uint32_t index;
+  float weight;
+};
+
+// The source pixels of each output pixel along one axis, widened when
+// shrinking so every source pixel counts (no aliasing on the orb).
+std::vector<std::vector<Tap>> Taps(uint32_t in, uint32_t out) {
+  std::vector<std::vector<Tap>> taps(out);
+  const float scale = float(in) / float(out);
+  const float stretch = std::max(1.0f, scale);
+  const float support = 2 * stretch;
+  for (uint32_t o = 0; o < out; ++o) {
+    const float center = (o + 0.5f) * scale - 0.5f;
+    const int first = int(std::floor(center - support)), last = int(std::ceil(center + support));
+    float sum = 0;
+    for (int i = first; i <= last; ++i) {
+      const float weight = CatmullRom((i - center) / stretch);
+      if (weight == 0) continue;
+      taps[o].push_back({uint32_t(std::clamp(i, 0, int(in) - 1)), weight});
+      sum += weight;
+    }
+    if (sum != 0)
+      for (Tap& tap : taps[o]) tap.weight /= sum;
+  }
+  return taps;
+}
+
+Image Fit(Image image, uint32_t px) {
+  if (image.width == px && image.height == px) return image;
+  return Resample(image, px, px);
+}
+
+// A neutral silver sphere with a green rim, for when there is no orb file.
+Image ProceduralOrb(uint32_t px) {
+  Image image = Blank(px, px);
+  const float radius = px / 2.0f;
+  const float light[3] = {-0.42f, -0.62f, 0.66f};
+  for (uint32_t y = 0; y < px; ++y)
+    for (uint32_t x = 0; x < px; ++x) {
+      const float nx = (x + 0.5f - radius) / radius, ny = (y + 0.5f - radius) / radius;
+      const float d = std::hypot(nx, ny);
+      const float cover = Coverage((d - 1) * radius);
+      if (cover <= 0) continue;
+      const float nz = std::sqrt(std::max(0.0f, 1 - d * d));
+      const float lambert = std::max(0.0f, nx * light[0] + ny * light[1] + nz * light[2]);
+      const float spec = std::pow(lambert, 28.0f);
+      const float base = 46 + 170 * std::pow(lambert, 0.85f);
+      const float rim = SmoothStep(0.72f, 1.0f, d) * 0.75f;
+      float rgb[3];
+      for (int c = 0; c < 3; ++c) rgb[c] = std::min(255.0f, base * (1 - rim) + kGreen[c] * rim + 255 * spec * 0.8f);
+      Blend(&image.rgba[(size_t(y) * px + x) * 4], rgb, cover);
+    }
+  return image;
+}
+
+Image Orb(uint32_t px) {
+  if (!orb_file.empty()) {
+    std::ifstream file(orb_file, std::ios::binary);
+    std::vector<uint8_t> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    Image image = Decode(bytes);
+    if (!image.rgba.empty()) {
+      image = Fit(std::move(image), px);
+      MaskCircle(image);
+      return image;
+    }
+    REXLOG_WARN("[narutorise] Achievements: the orb {} did not decode; using the built-in one",
+                orb_file.string());
+    orb_file.clear();
+  }
+  return ProceduralOrb(px);
+}
+
+Image Icon(uint32_t image_id, uint32_t px, bool locked) {
+  Image source = icon_source ? Decode(icon_source(image_id)) : Image{};
+  Image image;
+  if (source.rgba.empty()) {
+    // No picture in the title: the orb on a dark tile.
+    image = Blank(px, px);
+    const float tile[3] = {30, 30, 30};
+    for (size_t i = 0; i < image.rgba.size(); i += 4) Blend(&image.rgba[i], tile, 1);
+    const uint32_t orb = std::max<uint32_t>(1, uint32_t(px * 0.62f));
+    Over(image, Orb(orb), int(px - orb) / 2, int(px - orb) / 2);
+  } else {
+    image = Fit(std::move(source), px);
+  }
+  if (locked) {
+    for (size_t i = 0; i < image.rgba.size(); i += 4) {
+      uint8_t* p = &image.rgba[i];
+      const float gray = 0.299f * p[0] + 0.587f * p[1] + 0.114f * p[2];
+      // Nearly gray, darker, with a cold tint: clearly not earned yet.
+      const float tint[3] = {0.92f, 0.96f, 1.04f};
+      for (int c = 0; c < 3; ++c) {
+        const float value = (gray * 0.9f + p[c] * 0.1f) * 0.46f * tint[c] + 10;
+        p[c] = uint8_t(std::clamp(value, 0.0f, 255.0f));
+      }
+    }
+  }
+  MaskRounded(image, px * 0.14f);
+  return image;
+}
+
+// Two comets of light running around the ring between the orb and its frame,
+// over a faint glow of the whole ring. Rotating it moves the lights.
+Image Lights(uint32_t px) {
+  Image image = Blank(px, px);
+  const float radius = px / 2.0f;
+  for (uint32_t y = 0; y < px; ++y)
+    for (uint32_t x = 0; x < px; ++x) {
+      const float nx = (x + 0.5f - radius) / radius, ny = (y + 0.5f - radius) / radius;
+      const float d = std::hypot(nx, ny);
+      const float band = std::exp(-std::pow((d - 0.815f) / 0.05f, 2.0f));
+      if (band < 0.002f) continue;
+      const float theta = std::atan2(ny, nx);  // Clockwise on screen.
+      float tail = 0, head = 0;
+      for (const float lead : {0.0f, kPi}) {
+        float delta = std::fmod(lead - theta + 4 * kPi, 2 * kPi);  // Behind the head.
+        tail = std::max(tail, std::exp(-delta / 0.55f));
+        head = std::max(head, std::exp(-std::pow(delta / 0.11f, 2.0f)));
+      }
+      float rgb[3];
+      for (int c = 0; c < 3; ++c) rgb[c] = kGreen[c] + (kCore[c] - kGreen[c]) * head;
+      Blend(&image.rgba[(size_t(y) * px + x) * 4], rgb, band * Clamp01(0.14f + 0.95f * tail + 0.4f * head));
+    }
+  return image;
+}
+
+Image Glow(uint32_t px) {
+  Image image = Blank(px, px);
+  const float radius = px / 2.0f;
+  for (uint32_t y = 0; y < px; ++y)
+    for (uint32_t x = 0; x < px; ++x) {
+      const float d = std::hypot(x + 0.5f - radius, y + 0.5f - radius) / radius;
+      const float a = 0.6f * std::exp(-std::pow(d / 0.46f, 2.0f)) * (1 - SmoothStep(0.8f, 1.0f, d));
+      const float core = std::exp(-std::pow(d / 0.22f, 2.0f));
+      float rgb[3];
+      for (int c = 0; c < 3; ++c) rgb[c] = kGreen[c] + (kCore[c] - kGreen[c]) * core;
+      Blend(&image.rgba[(size_t(y) * px + x) * 4], rgb, a);
+    }
+  return image;
+}
+
+Image Shine(uint32_t width, uint32_t height) {
+  Image image = Blank(width, height);
+  const float white[3] = {255, 255, 255};
+  for (uint32_t y = 0; y < height; ++y)
+    for (uint32_t x = 0; x < width; ++x) {
+      const float u = (x + 0.5f) / width, v = (y + 0.5f) / height;
+      const float slant = u + (v - 0.5f) * 0.32f;
+      const float band = std::exp(-std::pow((slant - 0.5f) / 0.15f, 2.0f));
+      const float fade = SmoothStep(0.0f, 0.2f, v) * (1 - SmoothStep(0.8f, 1.0f, v));
+      Blend(&image.rgba[(size_t(y) * width + x) * 4], white, 0.38f * band * fade);
+    }
+  return image;
+}
+
+// A trophy in the green of the lights on a black disc: the cup with its two
+// handles, the stem and a two-step base, lighter at the top like lit metal.
+Image Trophy(uint32_t px) {
+  Image image = Blank(px, px);
+  const float s = float(px);
+  const float disc[3] = {6, 6, 6};
+  for (uint32_t y = 0; y < px; ++y)
+    for (uint32_t x = 0; x < px; ++x) {
+      float u = (x + 0.5f) / s, v = (y + 0.5f) / s;
+      uint8_t* p = &image.rgba[(size_t(y) * px + x) * 4];
+      Blend(p, disc, Coverage((std::hypot(u - 0.5f, v - 0.5f) - 0.5f) * s));
+      // The trophy's own coordinates: 15% larger than the unit square, so it fills the disc.
+      constexpr float kGrow = 1.15f;
+      const float shape_scale = s * kGrow;
+      u = 0.5f + (u - 0.5f) / kGrow;
+      v = 0.5f + (v - 0.5f) / kGrow;
+      // The cup: a flat rim over a half ellipse.
+      const float bowl = v < 0.36f ? RoundedBox(u, v, 0.5f, 0.29f, 0.2f, 0.07f, 0.01f)
+                                   : std::hypot((u - 0.5f) / 0.2f, (v - 0.36f) / 0.2f) * 0.2f - 0.2f;
+      const float rim = RoundedBox(u, v, 0.5f, 0.235f, 0.225f, 0.022f, 0.012f);
+      // The handles: the outer halves of two rings beside the cup.
+      const float left = u < 0.31f ? std::fabs(std::hypot(u - 0.31f, v - 0.335f) - 0.085f) - 0.024f : 1.0f;
+      const float right = u > 0.69f ? std::fabs(std::hypot(u - 0.69f, v - 0.335f) - 0.085f) - 0.024f : 1.0f;
+      const float stem = RoundedBox(u, v, 0.5f, 0.615f, 0.032f + 0.03f * std::max(0.0f, v - 0.62f) / 0.06f, 0.07f, 0.008f);
+      const float neck = RoundedBox(u, v, 0.5f, 0.6f, 0.06f, 0.018f, 0.01f);
+      const float base = std::min(RoundedBox(u, v, 0.5f, 0.705f, 0.12f, 0.025f, 0.012f),
+                                  RoundedBox(u, v, 0.5f, 0.765f, 0.17f, 0.03f, 0.014f));
+      const float shape = std::min({bowl, rim, left, right, stem, neck, base});
+      const float cover = Coverage(shape * shape_scale);
+      if (cover <= 0) continue;
+      // Lit from the top left: brighter there, a soft highlight on the bowl.
+      const float light = 1.12f - 0.42f * Clamp01((v - 0.2f) / 0.6f);
+      const float shine = std::exp(-std::pow((u - 0.42f) / 0.045f, 2.0f)) * SmoothStep(0.23f, 0.3f, v) *
+                          (1 - SmoothStep(0.4f, 0.5f, v));
+      float rgb[3];
+      for (int c = 0; c < 3; ++c) rgb[c] = std::min(255.0f, kGreen[c] * light + (kCore[c] - kGreen[c]) * 0.55f * shine);
+      Blend(p, rgb, cover);
+    }
+  return image;
+}
+
+// A padlock on a dark disc with a green rim.
+Image Lock(uint32_t px) {
+  Image image = Blank(px, px);
+  const float disc[3] = {18, 18, 18}, rim[3] = {kGreen[0], kGreen[1], kGreen[2]};
+  const float metal[3] = {232, 232, 232}, hole[3] = {24, 24, 24};
+  const float s = float(px);
+  for (uint32_t y = 0; y < px; ++y)
+    for (uint32_t x = 0; x < px; ++x) {
+      const float u = (x + 0.5f) / s, v = (y + 0.5f) / s;
+      uint8_t* p = &image.rgba[(size_t(y) * px + x) * 4];
+      const float d = std::hypot(u - 0.5f, v - 0.5f);
+      Blend(p, disc, 0.94f * Coverage((d - 0.5f) * s));
+      Blend(p, rim, Coverage((std::fabs(d - 0.47f) - 0.022f) * s));
+      // The shackle: the top half of a ring and its two legs into the body.
+      float shackle;
+      if (v < 0.46f) shackle = std::fabs(std::hypot(u - 0.5f, v - 0.46f) - 0.12f) - 0.03f;
+      else shackle = std::min(std::fabs(u - 0.38f), std::fabs(u - 0.62f)) - 0.03f + std::max(0.0f, v - 0.56f);
+      Blend(p, metal, Coverage(shackle * s));
+      Blend(p, metal, Coverage(RoundedBox(u, v, 0.5f, 0.635f, 0.2f, 0.155f, 0.045f) * s));
+      const float keyhole = std::min(std::hypot(u - 0.5f, v - 0.61f) - 0.036f,
+                                     RoundedBox(u, v, 0.5f, 0.67f, 0.014f, 0.05f, 0.01f));
+      Blend(p, hole, Coverage(keyhole * s));
+    }
+  return image;
+}
+
+bool Number(std::string_view text, uint32_t& value) {
+  const auto result = std::from_chars(text.data(), text.data() + text.size(), value);
+  return result.ec == std::errc() && result.ptr == text.data() + text.size();
+}
+
+}  // namespace
+
+void SetIconSource(std::function<std::vector<uint8_t>(uint32_t)> source) { icon_source = std::move(source); }
+void SetOrbFile(std::filesystem::path path) { orb_file = std::move(path); }
+
+Image Decode(std::span<const uint8_t> bytes) {
+  Image image;
+  if (bytes.empty()) return image;
+  int width = 0, height = 0;
+  image.rgba = rex::ui::DecodeImageRGBA(bytes.data(), bytes.size(), width, height);
+  if (image.rgba.empty() || width <= 0 || height <= 0) return {};
+  image.width = uint32_t(width);
+  image.height = uint32_t(height);
+  return image;
+}
+
+Image Resample(const Image& source, uint32_t width, uint32_t height) {
+  if (source.rgba.empty() || !width || !height) return {};
+  // Premultiplied, so transparent texels do not bleed their color into the edges.
+  std::vector<float> premultiplied(source.rgba.size());
+  for (size_t i = 0; i < source.rgba.size(); i += 4) {
+    const float a = source.rgba[i + 3] / 255.0f;
+    for (int c = 0; c < 3; ++c) premultiplied[i + c] = source.rgba[i + c] * a;
+    premultiplied[i + 3] = source.rgba[i + 3];
+  }
+  const auto columns = Taps(source.width, width), rows = Taps(source.height, height);
+  std::vector<float> horizontal(size_t(width) * source.height * 4, 0);
+  for (uint32_t y = 0; y < source.height; ++y)
+    for (uint32_t x = 0; x < width; ++x) {
+      float* out = &horizontal[(size_t(y) * width + x) * 4];
+      for (const Tap& tap : columns[x]) {
+        const float* in = &premultiplied[(size_t(y) * source.width + tap.index) * 4];
+        for (int c = 0; c < 4; ++c) out[c] += in[c] * tap.weight;
+      }
+    }
+  Image image = Blank(width, height);
+  for (uint32_t y = 0; y < height; ++y)
+    for (uint32_t x = 0; x < width; ++x) {
+      float sum[4] = {};
+      for (const Tap& tap : rows[y]) {
+        const float* in = &horizontal[(size_t(tap.index) * width + x) * 4];
+        for (int c = 0; c < 4; ++c) sum[c] += in[c] * tap.weight;
+      }
+      uint8_t* p = &image.rgba[(size_t(y) * width + x) * 4];
+      const float a = std::clamp(sum[3], 0.0f, 255.0f);
+      p[3] = uint8_t(a + 0.5f);
+      for (int c = 0; c < 3; ++c)
+        p[c] = a > 0 ? uint8_t(std::clamp(sum[c] / (a / 255.0f), 0.0f, 255.0f) + 0.5f) : 0;
+    }
+  return image;
+}
+
+std::optional<Image> Load(std::string_view source) {
+  constexpr std::string_view kPrefix = "achievement/";
+  const size_t at = source.find(kPrefix);
+  if (at == std::string_view::npos) return std::nullopt;
+  source.remove_prefix(at + kPrefix.size());
+  std::vector<std::string_view> parts;
+  for (size_t start = 0;;) {
+    const size_t slash = source.find('/', start);
+    parts.push_back(source.substr(start, slash == std::string_view::npos ? slash : slash - start));
+    if (slash == std::string_view::npos) break;
+    start = slash + 1;
+  }
+  constexpr uint32_t kMax = 2048;
+  uint32_t a = 0, b = 0;
+  const std::string_view kind = parts[0];
+  if ((kind == "icon" || kind == "locked") && parts.size() == 3 && Number(parts[1], a) && Number(parts[2], b) &&
+      b > 0 && b <= kMax)
+    return Icon(a, b, kind == "locked");
+  if (kind == "shine" && parts.size() == 2) {
+    const size_t x = parts[1].find('x');
+    if (x != std::string_view::npos && Number(parts[1].substr(0, x), a) && Number(parts[1].substr(x + 1), b) &&
+        a > 0 && b > 0 && a <= kMax && b <= kMax)
+      return Shine(a, b);
+    return std::nullopt;
+  }
+  if (parts.size() != 2 || !Number(parts[1], a) || a == 0 || a > kMax) return std::nullopt;
+  if (kind == "orb") return Orb(a);
+  if (kind == "trophy") return Trophy(a);
+  if (kind == "lights") return Lights(a);
+  if (kind == "glow") return Glow(a);
+  if (kind == "lock") return Lock(a);
+  return std::nullopt;
+}
+
+}  // namespace narutorise::menu::achievement_art
