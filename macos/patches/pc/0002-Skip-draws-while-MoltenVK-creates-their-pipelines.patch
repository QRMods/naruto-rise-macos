From e504139d4ebe547558c7670945e2f21bfcaeb70b Mon Sep 17 00:00:00 2001
From: alantero <36408154+alantero@users.noreply.github.com>
Date: Fri, 30 Oct 2026 01:34:36 +0100
Subject: [PATCH 2/5] Skip draws while MoltenVK creates their pipelines

On MoltenVK a new graphics pipeline translates its shaders to Metal and
compiles them, from tens to hundreds of milliseconds on the render thread.
Every fence wait of the title waited behind it, so the frame froze each
time the game showed something new.

On macOS the Vulkan backend now takes pipelines like the D3D12 backend: a
pipeline that is not ready goes to the asynchronous threads, at normal
priority, and its draw is skipped until the pipeline exists.

Only the draws the next frames redo skip: those into a target the title
has been drawing every frame. A draw into a new target, or one drawn only
now and then, can be drawn once and sampled for many frames, and so can a
tiny target (a lookup such as the one-row colour ramps of the rage mode).
Skipped, they stayed black: the whole screen went black during the rage
mode. Those draws take their pipeline as the prefetch take, posted in
parallel with their batch and waited for.

REX_NATIVE_PSO_ASYNC=prefetch keeps the previous behavior (no draw
skips). Other systems are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/gpu/backend/vulkan/backend.cpp | 33 +++++++++++++++++++
 app/src/gpu/backend/vulkan/draw.inc    | 45 ++++++++++++++++++++++++--
 app/src/gpu/d3d/draw.cpp               | 11 +++++++
 3 files changed, 86 insertions(+), 3 deletions(-)

diff --git a/app/src/gpu/backend/vulkan/backend.cpp b/app/src/gpu/backend/vulkan/backend.cpp
index 5ecf0f7..bfe2a6d 100644
--- a/app/src/gpu/backend/vulkan/backend.cpp
+++ b/app/src/gpu/backend/vulkan/backend.cpp
@@ -464,12 +464,42 @@ struct Backend::State {
     std::unique_ptr<plume::RenderFramebuffer> framebuffer;  // The surface alone: its clears.
     SyncState state;
     uint64_t last_use = 0;  // Highest sequence of submitted or recorded work using it.
+#if defined(__APPLE__)
+    // The last frame that drew into it and the first frame of that run of
+    // drawn frames (State::NoteDrawn); 0: never drawn.
+    uint64_t drawn_frame = 0, drawn_since = 0;
+#endif
     VkImage Image() const { return static_cast<plume::VulkanTexture*>(texture.get())->vk; }
     VkImageAspectFlags Aspect() const {
       return desc.format == SurfaceFormat::DepthStencil ? VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT
                                                         : VK_IMAGE_ASPECT_COLOR_BIT;
     }
   };
+#if defined(__APPLE__)
+  // The skip take of macOS (draw.inc). frame_serial counts the closed frames
+  // (CloseFrame). A run of drawn frames survives one frame without draws.
+  uint64_t frame_serial = 1;
+  void NoteDrawn(Surface& target) {
+    if (target.drawn_frame == frame_serial) return;
+    if (!target.drawn_frame || target.drawn_frame + 2 < frame_serial) target.drawn_since = frame_serial;
+    target.drawn_frame = frame_serial;
+  }
+  // Whether a draw may skip while its pipeline is created: only when the next
+  // frames draw it again over what it misses, so it is gone just until its
+  // pipeline exists: a target the title has been drawing every frame (the
+  // scene, its interface, its screen-sized passes). A draw into a new target,
+  // or one drawn only now and then, may be drawn once and sampled for many
+  // frames; so may a tiny target, a lookup the title computes (the colour
+  // ramps of the rage mode are one row high). Skipped, those stay black
+  // until the title draws them again (the screen went black for the whole
+  // rage mode); they wait for their pipeline instead.
+  static constexpr uint64_t kSkipRun = 2;      // Frames the target was drawn before.
+  static constexpr uint32_t kTinyTarget = 16;  // Guest pixels, either side.
+  bool SkipHeals(const Surface& target) const {
+    return target.guest.width > kTinyTarget && target.guest.height > kTinyTarget && target.drawn_frame &&
+           target.drawn_frame + 2 >= frame_serial && target.drawn_since + kSkipRun <= frame_serial;
+  }
+#endif
   std::unordered_map<uint32_t, Surface> surfaces;
   std::vector<Surface> retired_surfaces;  // Released, waiting for their sequence.
   // Own textures of guest texture headers: the resolve destinations.
@@ -1505,6 +1535,9 @@ bool Backend::CloseFrame(FrameEvent event, uint64_t& target, std::string& eviden
   VkResult result = VK_SUCCESS;
   if (!state_->CloseBatch(batch_reason, result)) return fail(batch_reason, result);
   state_->pipeline_set.EndFrame();
+#if defined(__APPLE__)
+  ++state_->frame_serial;  // The skip take's frames (State::SkipHeals).
+#endif
   target = state_->next_sequence - 1;  // The last submission.
   const uint64_t completed = state_->completion->Completed();
   if (!state_->completion->SetEventOnCompletion(target, std::move(event)))
diff --git a/app/src/gpu/backend/vulkan/draw.inc b/app/src/gpu/backend/vulkan/draw.inc
index 4dd5ab0..983dcf2 100644
--- a/app/src/gpu/backend/vulkan/draw.inc
+++ b/app/src/gpu/backend/vulkan/draw.inc
@@ -106,11 +106,21 @@ void Backend::PrefetchPipelines(const std::vector<DrawRequest>& requests) {
   s.prefetched_keys.assign(requests.size(), {});
   for (size_t i = 0; i < requests.size(); ++i) {
     const auto& r = requests[i];
+#if defined(__APPLE__)
+    // The draws of the skip take that must not skip (State::SkipHeals) take
+    // their pipelines as the prefetch take: posted here, in parallel.
+    const bool skip_take = r.pipeline_take == DrawRequest::PipelineTake::kSkip;
+    if ((r.pipeline_take != DrawRequest::PipelineTake::kPrefetch && !skip_take) || !r.elements) continue;
+#else
     if (r.pipeline_take != DrawRequest::PipelineTake::kPrefetch || !r.elements) continue;
+#endif
     auto color = s.surfaces.find(r.color_key), depth = s.surfaces.find(r.depth_key);
     const bool has_color = color != s.surfaces.end();
     const bool has_depth = (r.depth_enable || r.stencil_enable) && depth != s.surfaces.end();
     if (!has_color && !has_depth) continue;
+#if defined(__APPLE__)
+    if (skip_take && s.SkipHeals(has_color ? color->second : depth->second)) continue;
+#endif
     const uint32_t samples = has_color ? color->second.desc.samples : depth->second.desc.samples;
     const uint64_t layout_id = r.layout_id ? r.layout_id : ElementsId(*r.elements);
     std::array<uint32_t, 21> words{};
@@ -195,18 +205,39 @@ bool Backend::DrawIndexed(const DrawRequest& r, uint64_t& fence, std::string& ev
   const uint64_t key = keyed ? prefetched->key : VulkanPipelineKey(r.vs, r.ps, layout_id, state_words);
   auto& pipeline = s.pipelines[key];
   const bool created = !pipeline;
+  bool skip_draw = false;  // The pipeline is being created asynchronously (skip take).
   if (!pipeline) {
     if (keyed && !words()) { s.pipelines.erase(key); return fail("native-draw-topology-uncovered"); }
     // The description is copied only for a pipeline the backend lacks.
     const PipelineDesc desc{r.vs, r.ps, r.elements, layout_id, state_words};
     const uint64_t triple = TripleKey(r.vs.key, r.ps.key, layout_id);
+#if defined(__APPLE__)
+    // The skip take, as the D3D12 backend: a pipeline not ready is posted to
+    // the asynchronous threads and the draw is recorded without itself. On
+    // MoltenVK a creation costs tens to hundreds of milliseconds on this
+    // thread, which every fence wait of the title waits behind. The skipped
+    // draws come back as soon as their pipelines exist, so the threads keep
+    // the normal priority. Only the draws the next frames redo skip
+    // (State::SkipHeals); the others take their pipeline as the prefetch take
+    // (waited for or created here), as Vulkan does on other systems.
+    auto policy = r.pipeline_take;
+    if (policy == DrawRequest::PipelineTake::kSkip && !s.SkipHeals(target))
+      policy = DrawRequest::PipelineTake::kPrefetch;
+    auto take = s.pipeline_set.Take(key, triple, policy);
+    skip_draw = take.skip;
+    if (take.post) s.pipeline_set.Post(key, PipelineDesc(desc), false, false);
+#else
     // Normal and diagnostic draws both remain visible on Vulkan. Never skip
     // a draw because a pipeline compilation is pending.
     auto take = s.pipeline_set.Take(key, triple, r.pipeline_take == DrawRequest::PipelineTake::kSkip ?
         DrawRequest::PipelineTake::kPrefetch : r.pipeline_take);
+#endif
     pipeline = std::move(take.pipeline);
     s.pipeline_origins[key] = take.origin ? take.origin : "created";
-    if (!pipeline) {
+    if (skip_draw) {
+      s.pipelines.erase(key);  // `pipeline` is not used below.
+      s.pipeline_origins.erase(key);
+    } else if (!pipeline) {
       const auto begin = std::chrono::steady_clock::now();
       const auto result = MakeGraphicsPipeline(s.vulkan->vk, s.draw_layout, desc, s.vertex_locations, pipeline);
       if (!result.ok) { s.pipelines.erase(key); return fail(result.reason, VkResult(result.code)); }
@@ -214,15 +245,23 @@ bool Backend::DrawIndexed(const DrawRequest& r, uint64_t& fence, std::string& ev
       s.pipeline_create_us[key] = micros;
       s.pipeline_origins[key] = s.pipeline_set.NoteCreated(take, triple, micros);
     }
-    s.pipeline_worlds[key] = WorldKey();
-    s.pipeline_descs.emplace(key, desc);
+    if (!skip_draw) {
+      s.pipeline_worlds[key] = WorldKey();
+      s.pipeline_descs.emplace(key, desc);
+    }
   }
+#if defined(__APPLE__)
+  s.NoteDrawn(color ? *color : *depth);  // After the take: it reads the frames before.
+#endif
   if (!ApplyDrawConstants(r.vs_constants, r.vs_constants_delta, s.vs_block) ||
       !ApplyDrawConstants(r.ps_constants, r.ps_constants_delta, s.ps_block)) return fail("native-draw-constants");
   // Uploads may close a full batch, so perform all of them before allocating
   // this draw's descriptors and retaining its resources.
   for (const auto& t : r.textures) if (!t.resolved && !t.data.empty())
     if (!UploadSampled(t, evidence)) return false;
+  // A skipped draw keeps the constants and the texture copies later draws
+  // build on, and records nothing (its pass needs the pipeline's).
+  if (skip_draw) return true;
   const char* reason = nullptr; VkResult result = VK_SUCCESS;
   if (!s.OpenBatch(reason, result)) return fail(reason, result);
   s.batch.list->setFramebuffer(nullptr);
diff --git a/app/src/gpu/d3d/draw.cpp b/app/src/gpu/d3d/draw.cpp
index 96d2f25..35542a4 100644
--- a/app/src/gpu/d3d/draw.cpp
+++ b/app/src/gpu/d3d/draw.cpp
@@ -368,8 +368,19 @@ DrawRequest::PipelineTake BatchedPipelineTake() {
     const char* text = std::getenv("REX_NATIVE_PSO_ASYNC");
     const std::string_view option = text ? text : "";
     if (option == "0") return DrawRequest::PipelineTake::kSync;
+#if defined(__APPLE__)
+    // On MoltenVK a new pipeline translates its shaders to Metal and compiles
+    // them, up to hundreds of milliseconds: waiting for it froze the frame each
+    // time the game showed something new. The draw of a pipeline not ready
+    // skips until its creation ends when the next frames redo it (a target
+    // drawn every frame); the Vulkan backend waits for the others (State::SkipHeals).
+    // REX_NATIVE_PSO_ASYNC=prefetch waits for every pipeline.
+    if (option == "prefetch") return DrawRequest::PipelineTake::kPrefetch;
+    return DrawRequest::PipelineTake::kSkip;
+#else
     if (option == "1" && Diagnostics()) return DrawRequest::PipelineTake::kSkip;
     return DrawRequest::PipelineTake::kPrefetch;
+#endif
   }();
   return value;
 }
