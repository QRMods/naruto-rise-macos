@@ -115,10 +115,29 @@ bool Backend::AttachWindow(void* window, std::string& evidence, const PresentMod
   vkGetPhysicalDeviceFeatures2(s.vulkan->physicalDevice, &features);
   if (!maintenance.swapchainMaintenance1)
     return GraphicsError(evidence, "native-vulkan-swapchain-maintenance1-required", VK_ERROR_FEATURE_NOT_PRESENT);
+#if defined(__APPLE__)
+  // The window is the SDL window: its Metal layer, made on the UI thread as
+  // Cocoa requires, backs the surface (VK_EXT_metal_surface of MoltenVK).
+  static SDL_MetalView metal_view = nullptr;
+  void* layer = nullptr;
+  auto* app = rex::Runtime::instance() ? rex::Runtime::instance()->app_context() : nullptr;
+  if (app) {
+    app->CallInUIThreadSynchronous([&] {
+      if (!metal_view) metal_view = SDL_Metal_CreateView(static_cast<SDL_Window*>(window));
+      if (metal_view) layer = SDL_Metal_GetLayer(metal_view);
+    });
+  }
+  if (!layer) return GraphicsError(evidence, "native-vulkan-metal-layer");
+  VkMetalSurfaceCreateInfoEXT info{VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT};
+  info.pLayer = static_cast<const CAMetalLayer*>(layer);
+  VkResult result = vkCreateMetalSurfaceEXT(static_cast<plume::VulkanInterface*>(s.render.get())->instance,
+      &info, nullptr, &s.window_surface);
+#else
   VkWin32SurfaceCreateInfoKHR info{VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR};
   info.hinstance = GetModuleHandleW(nullptr); info.hwnd = HWND(window);
   VkResult result = vkCreateWin32SurfaceKHR(static_cast<plume::VulkanInterface*>(s.render.get())->instance,
       &info, nullptr, &s.window_surface);
+#endif
   if (result != VK_SUCCESS) return GraphicsError(evidence, "native-vulkan-window-surface", result);
   VkBool32 supported = VK_FALSE;
   result = vkGetPhysicalDeviceSurfaceSupportKHR(s.vulkan->physicalDevice, s.vulkan->queueFamilyIndices[0], s.window_surface, &supported);
diff --git a/app/src/gpu/common/guest_memory.h b/app/src/gpu/common/guest_memory.h
index 38fe2a7..95c708a 100644
--- a/app/src/gpu/common/guest_memory.h
+++ b/app/src/gpu/common/guest_memory.h
@@ -63,6 +63,25 @@ inline uint32_t GuestPhysicalAlias(uint32_t address) { return (((address >> 20)
 // stores; ReadProcessMemory and WriteProcessMemory would make a system call
 // at every access. An address without memory faults into the __except and
 // fails.
+#if defined(__APPLE__)
+// macOS has no __try: the kernel copies a read and fails on an unmapped page.
+// A write is checked the same way first, then stored as the title would, so
+// the SDK's write watches still see it.
+inline bool CopyFromGuest(void* out, const uint8_t* host, size_t size) {
+  return ReadProcessMemory(GetCurrentProcess(), host, out, size, nullptr) != 0;
+}
+inline bool CopyToGuest(uint8_t* host, const uint8_t* bytes, size_t size) {
+  if (!size) return true;
+  uint8_t probe;
+  constexpr uintptr_t kPage = 4096;
+  for (uintptr_t page = uintptr_t(host) & ~(kPage - 1); page < uintptr_t(host) + size; page += kPage) {
+    const auto* at = reinterpret_cast<const uint8_t*>(std::max(page, uintptr_t(host)));
+    if (!ReadProcessMemory(GetCurrentProcess(), at, &probe, 1, nullptr)) return false;
+  }
+  std::memcpy(host, bytes, size);
+  return std::memcmp(host, bytes, size) == 0;
+}
+#else
 inline bool CopyFromGuest(void* out, const uint8_t* host, size_t size) {
   __try {
     std::memcpy(out, host, size);
@@ -79,6 +98,7 @@ inline bool CopyToGuest(uint8_t* host, const uint8_t* bytes, size_t size) {
     return false;
   }
 }
+#endif
 inline bool ReadPhysical(uint8_t* base, uint32_t physical, uint32_t size, void* out) {
   if (physical >= 0x20000000u || size > 0x20000000u - physical) return false;
   return CopyFromGuest(out, base + 0x100000000ull + physical, size);
