diff --git a/app/src/gpu/backend/pipeline_set.cpp b/app/src/gpu/backend/pipeline_set.cpp
index 2026ae3..7a9abd0 100644
--- a/app/src/gpu/backend/pipeline_set.cpp
+++ b/app/src/gpu/backend/pipeline_set.cpp
@@ -87,7 +87,14 @@ bool PipelineSet::Post(uint64_t key, PipelineDesc desc, bool only_if_absent, boo
 // Two thirds of the hardware threads, at least two, as the recomps.
 void PipelineSet::StartThreads(bool lowest) {
   const unsigned threads = std::max(2u, std::thread::hardware_concurrency() * 2 / 3);
+#if defined(__APPLE__)
+  // The skip take is the macOS default: the skipped draws come back as soon
+  // as their pipelines are created, so the threads keep the normal priority.
+  (void)lowest;
+  const int base = THREAD_PRIORITY_NORMAL;
+#else
   const int base = lowest ? THREAD_PRIORITY_LOWEST : THREAD_PRIORITY_NORMAL;
+#endif
   for (unsigned i = 0; i < threads; ++i) threads_.emplace_back([this, base] { Work(base); });
 }
 
